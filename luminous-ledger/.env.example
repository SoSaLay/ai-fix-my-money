# ─── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Plaid (sandbox for development) ─────────────────────────
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-sandbox-secret
PLAID_ENV=sandbox
# Options: sandbox | development | production

# ─── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── MCP (Perplexity remote connector) ───────────────────────
# MCP_SECRET: bearer token Perplexity sends with every tool call.
# Generate with: openssl rand -hex 32
MCP_SECRET=replace_with_your_own_secret_openssl_rand_hex_32

# MCP_TARGET_USER_ID: the Supabase auth.users.id whose dashboard gets updated.
# Find yours in Supabase → Authentication → Users.
MCP_TARGET_USER_ID=replace_with_your_supabase_user_uuid
