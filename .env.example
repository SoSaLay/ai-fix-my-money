# ─── Local only. Never set in production. ────────────────────────────────────
# Used by `npm run ingest` to pull candidate videos. The deployed app makes no
# TikHub calls at all, so this key never leaves your machine.
# Scope needed: /api/v1/tiktok/app/v3/
TIKHUB_API_KEY=

# ─── Production too. ─────────────────────────────────────────────────────────
# Grades written quiz answers against the reviewer's reference answer.
ANTHROPIC_API_KEY=

# Signs quiz attempt tokens, which carry the sampled question ids between
# serving and grading. Any random string of 32+ characters:
#   openssl rand -base64 32
# Rotating it invalidates every in-flight attempt.
QUIZ_ATTEMPT_SECRET=

# ─── Supabase: accounts and stored progress ──────────────────────────────────
# Leave all three blank to run the app the way it worked before accounts
# existed: no sign-in, everything in this browser's local storage.
#
# The URL and the anon key are public by design — the anon key ships in the
# browser bundle, and row-level security, not secrecy, is what protects the
# data. See supabase/migrations/0001_init.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# This one is NOT public. It bypasses row-level security entirely and is used
# only server-side, for the two writes a learner must not make for themselves:
# their own quiz score and their own grade.
SUPABASE_SERVICE_ROLE_KEY=

# ─── PostHog: product analytics ──────────────────────────────────────────────
# Leave blank to collect nothing. Requests are proxied through /ingest so an ad
# blocker cannot remove them; session replay and autocapture are off, because
# this app has people's finances on screen.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
